# x86_64 bootstrap pins the official multi-stage-capable Arch Linux base image
# by digest (tag base-20260823.0.578598, amd64 index).
FROM docker.io/library/archlinux@sha256:b860afd5823683f7ea389ba5f00d812f4fe55f6f286dea329d2abeefa535e309

RUN test "$(uname -m)" = x86_64

RUN pacman-key --init && pacman-key --populate archlinux && \
    pacman -Syu --noconfirm && \
    pacman -S --needed --noconfirm arch-install-scripts e2fsprogs git python zstd && \
    pacman -Scc --noconfirm

WORKDIR /workspace
ENTRYPOINT ["/workspace/guest/build.sh"]
