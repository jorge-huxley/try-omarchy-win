#!/bin/bash

set -euo pipefail

guest_dir=$(cd "$(dirname "$0")" && pwd)
source_dir=""

while (($#)); do
  case "$1" in
    --source)
      source_dir=${2:-}
      shift 2
      ;;
    -h|--help)
      echo "Usage: guest/test [--source PINNED_OMARCHY_CHECKOUT]"
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 2
      ;;
  esac
done

args=()
if [[ -n $source_dir ]]; then
  args+=(--source "$source_dir")
elif [[ -d /private/tmp/omarchy-source-inspected/.git ]]; then
  args+=(--source /private/tmp/omarchy-source-inspected)
fi

PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover \
  -s "$guest_dir/tests" \
  -p 'test_*.py' || (( $? == 5 ))

if ((${#args[@]})); then
  exec python3 "$guest_dir/tests/verify.py" "${args[@]}"
fi
exec python3 "$guest_dir/tests/verify.py"
